@page "/register"
@layout EmptyLayout
@inject WalletApi Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Create account · GoldArrow Bank</PageTitle>

<section class="auth-hero">
    <div class="auth-copy">
        <BrandLockup CssClass="hero" />
        <h1>Open your vault.</h1>
        <p class="lede">Create an account and get a TRY wallet instantly — ready for deposits, withdrawals, and transfers.</p>
    </div>

    <form class="auth-panel" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <h2>Create account</h2>
        <label>
            Full name
            <input @bind="fullName" required maxlength="100" />
        </label>
        <label>
            Email
            <input type="email" @bind="email" required autocomplete="username" />
        </label>
        <label>
            Password
            <input type="password" @bind="password" required minlength="6" autocomplete="new-password" />
        </label>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="error" role="alert">@error</p>
        }
        <button class="btn primary" type="submit" disabled="@busy">@(busy ? "Creating…" : "Create account")</button>
        <p class="muted">Already registered? <a href="login">Sign in</a></p>
    </form>
</section>

@code {
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string? error;
    private bool busy;

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;
        try
        {
            var auth = await Api.RegisterAsync(email.Trim(), fullName.Trim(), password);
            await Session.SetAsync(auth);
            Nav.NavigateTo("wallet");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (Exception)
        {
            error = "Cannot reach API. Is it running on http://localhost:5088?";
        }
        finally
        {
            busy = false;
        }
    }
}
